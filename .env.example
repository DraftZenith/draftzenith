# Copy to .env for local development. Never commit real credentials.
SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Server-only secret used by the assessment submission function.
# Configure this as a Cloudflare Workers secret; never expose it to VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Assessment form stays closed unless BOTH values are configured for a reviewed launch.
VITE_ASSESSMENT_FORM_ENABLED=false
VITE_PRIVACY_NOTICE_URL=
